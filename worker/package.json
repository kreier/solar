{
  "name": "solar-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker & D1 ingestion for ESP32 Solar Monitoring Fleet",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute solar-db --file=migrations/0001_initial_schema.sql",
    "d1:init:local": "wrangler d1 execute solar-db --local --file=migrations/0001_initial_schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240405.0",
    "typescript": "^5.4.5",
    "wrangler": "^4.164.0"
  }
}
